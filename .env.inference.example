# Env for docker-compose.inference.yml (asset_edge sidecar).
# Created/filled by: ./prepare.sh --with-inference
# Do not commit .env.inference (gitignored).

# --- Image (multi-arch amd64/arm64; same registry as the asset node) ---
ANX_INFERENCE_IMAGE=eu1.dockerreg.sdk.assetsnexus.org/nexus/inference/anx.inference.backend
ANX_INFERENCE_TAG=0.1.3
ANX_INFERENCE_PORT=3055

# --- Edge mode (requires a published image that understands asset_edge) ---
ANX_INFERENCE_MODE=asset_edge
ANX_ASSETS_NODE_URL=http://anx-assets-node:28480
ANX_EDGE_LOCAL_TOKEN_FILE=/edge/local-trust.token
# Optional floor for discovery handshake (asset node / edge reconciler):
# ANX_EDGE_MIN_VERSION=0.1.0

# Nest listen address (must match ANX_INFERENCE_PORT / healthcheck)
APP_HOST=0.0.0.0
APP_PORT=3055
NODE_ENV=production

# --- Storage (filled by ./up.sh from generated secrets; do not edit) ---
MONGODB_URI=mongodb://admin:CHANGE_ME@mongodb:27017/anx_inference?authSource=admin
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_TLS_ENABLED=false
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET=inference
AWS_ACCESS_KEY_ID=anx
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
MINIO_ROOT_USER=anx
MINIO_ROOT_PASSWORD=CHANGE_ME

# Edge profile: Mongo + Redis only (no Scylla / room fan-out on a Pi)
SCYLLA_ENABLED=false

# JWT secrets — prepare.sh generates when empty
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cognee memory backend (off by default)
# ANX_EDGE_COGNEE_ENABLED=false

# Asset node discovers this sidecar at:
#   ANX_EDGE_INFERENCE_URL=http://anx-inference:3055
# (set in the main .env by prepare.sh --with-inference)
