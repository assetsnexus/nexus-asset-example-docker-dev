[
  {
    "id": "portio-tab",
    "type": "tab",
    "label": "port-io",
    "disabled": false,
    "info": "Subscribe to anx/<asset>/port/<port>/{active,error}. Publish relay_state. Green LED follows active, red LED follows error."
  },
  {
    "id": "portio-broker",
    "type": "mqtt-broker",
    "name": "ipc-mqtt",
    "broker": "mqtt",
    "port": "8883",
    "tls": "portio-tls",
    "usetls": true,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoConnect": true,
    "clientid": "nodered-port-io"
  },
  {
    "id": "portio-tls",
    "type": "tls-config",
    "name": "mqtt-ca",
    "cert": "",
    "key": "",
    "ca": "/certs/ca.crt",
    "verifyservercert": true
  },
  {
    "id": "portio-in-active",
    "type": "mqtt in",
    "z": "portio-tab",
    "name": "port active",
    "topic": "anx/+/port/+/active",
    "qos": "1",
    "datatype": "utf8",
    "broker": "portio-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 140,
    "y": 80,
    "wires": [["portio-fn-active"]]
  },
  {
    "id": "portio-in-error",
    "type": "mqtt in",
    "z": "portio-tab",
    "name": "port error",
    "topic": "anx/+/port/+/error",
    "qos": "1",
    "datatype": "utf8",
    "broker": "portio-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 140,
    "y": 180,
    "wires": [["portio-fn-error"]]
  },
  {
    "id": "portio-fn-active",
    "type": "function",
    "z": "portio-tab",
    "name": "relay + green LED",
    "func": "const parts = String(msg.topic || '').split('/');\nconst asset = parts[1] || '';\nconst port = parts[3] || '';\nconst on = Number(msg.payload) >= 1 ? 1 : 0;\nconst base = 'anx/' + asset + '/port/' + port;\nnode.send([\n  { topic: base + '/relay_state', payload: String(on), qos: 1, retain: true },\n  { topic: base + '/led/green', payload: String(on), qos: 0, retain: true }\n]);\nreturn null;",
    "outputs": 2,
    "x": 380,
    "y": 80,
    "wires": [["portio-out-relay"], ["portio-out-green"]]
  },
  {
    "id": "portio-fn-error",
    "type": "function",
    "z": "portio-tab",
    "name": "red LED",
    "func": "const parts = String(msg.topic || '').split('/');\nconst asset = parts[1] || '';\nconst port = parts[3] || '';\nconst on = Number(msg.payload) >= 1 ? 1 : 0;\nmsg.topic = 'anx/' + asset + '/port/' + port + '/led/red';\nmsg.payload = String(on);\nmsg.retain = true;\nreturn msg;",
    "outputs": 1,
    "x": 360,
    "y": 180,
    "wires": [["portio-out-red"]]
  },
  {
    "id": "portio-out-relay",
    "type": "mqtt out",
    "z": "portio-tab",
    "name": "relay_state",
    "topic": "",
    "qos": "1",
    "retain": "true",
    "broker": "portio-broker",
    "x": 620,
    "y": 60,
    "wires": []
  },
  {
    "id": "portio-out-green",
    "type": "mqtt out",
    "z": "portio-tab",
    "name": "green LED",
    "topic": "",
    "qos": "0",
    "retain": "true",
    "broker": "portio-broker",
    "x": 620,
    "y": 110,
    "wires": []
  },
  {
    "id": "portio-out-red",
    "type": "mqtt out",
    "z": "portio-tab",
    "name": "red LED",
    "topic": "",
    "qos": "0",
    "retain": "true",
    "broker": "portio-broker",
    "x": 610,
    "y": 180,
    "wires": []
  },
  {
    "id": "portio-note",
    "type": "comment",
    "z": "portio-tab",
    "name": "Set the ipc-mqtt broker user anx and the MQTT password. Map led/green, led/red, and relay_state onto the Pi GPIO in this tab if the HAT is present. CA is /certs/ca.crt.",
    "x": 420,
    "y": 260,
    "wires": []
  }
]
