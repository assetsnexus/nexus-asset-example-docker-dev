# ANX asset IPC — copy to .env via ./prepare.sh (do not commit secrets).
# One asset per IPC. Linux amd64 / Raspberry Pi arm64. Windows untested.

# --- Image (multi-arch manifest; omit DOCKER_DEFAULT_PLATFORM so Docker matches host CPU) ---
ANX_ASSETS_NODE_IMAGE=eu1.dockerreg.sdk.assetsnexus.org/anx-assets-node
ANX_ASSETS_NODE_TAG=latest
# DOCKER_DEFAULT_PLATFORM=   # leave unset; forcing amd64 on a Pi causes exec format error

# --- Compose profiles (comma-separated). Default matches a typical portal ZIP. ---
# Always started (no profile): anx-assets-node, victoriametrics
# registry-db — postgres, mongodb, redis (optional for small boxes; node does not require live clients today)
# observe   — grafana, prometheus, node-exporter
# oem       — mqtt, nodered (optional OEM / Node-RED consumer)
# logs      — loki
COMPOSE_PROFILES=registry-db,observe

# --- Operation (single asset on this IPC) ---
SINGLE_ASSET_MODE=true
SINGLE_ASSET_DIR=asset-local
OPERATION_MODE=single_asset
ANX_ENVIRONMENT=production
LOCAL_DATA_PATH=/app/local_data
RUST_LOG=anx_assets_node=info,info

# --- USB init scan root (host path; rslave-mounted into the container as /media/usb) ---
ANX_USB_ASSET_INIT_ROOT=/media/usb

# --- Ports (match data/config/general.yml when present) ---
SERVER_PORT=8080
INTERNAL_PORT=8081
GRPC_PORT=50051
WEBSOCKET_PORT=8082
VICTORIAMETRICS_PORT=8428
GRAFANA_PORT=3001
PROMETHEUS_SERVER_PORT=9095
NODE_EXPORTER_PORT=9100
POSTGRES_PORT=5432
MONGO_PORT=27018
REDIS_PORT=6379
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_WS_PORT=9001
# Mosquitto TLS (profile oem). prepare.sh generates data/mqtt/certs/ (gitignored).
MQTT_BROKER=mqtts://127.0.0.1:8883
MQTT_CA_FILE=/app/local_data/mqtt/certs/ca.crt
# ANX_MQTT_INSECURE=1  # lab only: allow plaintext mqtt:// (not the default)
NODERED_PORT=1880
LOKI_PORT=3100

# --- VictoriaMetrics (always on) ---
VICTORIAMETRICS_URL=http://victoriametrics:8428

# --- Secrets: prepare.sh generates when empty; never overwrite existing values ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=anx_assets
POSTGRES_DATABASE=anx_assets

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=anx-asset
MONGO_DATABASE=anx-asset

REDIS_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Mosquitto user `anx` when profile oem is on (prepare.sh writes data/mqtt/passwd)
MQTT_PASSWORD=

# --- Optional: filled by import-asset.sh from a portal ZIP ---
# ANX_ASSET_INSTANCE_ID=
# ANX_ASSET_NAME=
# ANX_REGION_SLUG=
# ANX_REGISTRATION_CODE=
